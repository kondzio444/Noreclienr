{
  // Nore Client website + API – Cloudflare Workers with static assets (no R2).
  // Deploy: npx wrangler deploy   (CI: .github/workflows/web.yml)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noreclient",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "routes": [
    { "pattern": "noroclient.pl", "custom_domain": true },
    { "pattern": "www.noroclient.pl", "custom_domain": true }
  ],
  // background refresh of the release data (src/worker.js → scheduled)
  "triggers": { "crons": ["*/15 * * * *"] },
  // Nore Hub: one SQLite-backed Durable Object with the Nore players (src/hub.js)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "NoreHub" }] },
  "migrations": [{ "tag": "hub-v1", "new_sqlite_classes": ["NoreHub"] }],
  "observability": { "enabled": true }
}
