{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nore Launcher",
  "mainBinaryName": "nore-launcher",
  "identifier": "pl.noreclient.launcher",
  "build": {
    "frontendDist": "../../launcher/src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kondzio444",
    "copyright": "Copyright © 2026 kondzio444",
    "category": "Game",
    "shortDescription": "Launcher Nore Client",
    "longDescription": "Launcher Nore Client – wersje Minecraft, Fabric, Quilt, Forge i NeoForge, konta premium i non-premium.",
    "homepage": "https://noreclient.pl",
    "license": "Apache-2.0",
    "icon": ["../../launcher/build/icon.png", "../../launcher/build/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Polish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://noreclient.pl/api/v2/updates/feed/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
