# Nore Bot – copy to .env and fill in. NEVER commit .env (the repository is public).

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=123456789012345678

# Nore API (v2 under /api/v2, public v1 under /api/v1)
NORE_API=https://noreclient.pl
# Shared secret for the bot endpoints of API v2 (Authorization: Bot <secret>). Empty = offline mode
# (configs only from local cache, defaults and /config).
NORE_BOT_SECRET=

# Slash command deployment: empty = global, or a guild id for instant per-guild registration (testing)
# several servers: comma separated, e.g. DEPLOY_GUILD_ID=111111111111111111,222222222222222222
DEPLOY_GUILD_ID=

# Sharding: empty/"auto" = ask Discord for the recommended shard count (1 shard runs in-process),
# or a fixed number, e.g. 2
BOT_SHARDS=auto

# Data directory (JSON store). Default: ./data
DATA_DIR=./data

# Logs: info | debug | warn | error ; LOG_FORMAT=pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty

# Optional – Twitch live notifications (Helix, app access token). Missing = Twitch feeds disabled.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional – base URL of an RSS-Bridge instance for TikTok / Instagram / X feeds, e.g. https://rss-bridge.example.org
RSS_BRIDGE_URL=

# Optional – HTTP API for the Minecraft server plugin (chat bridge, /link, rank roles).
# Empty = off. See docs/minecraft-integration.md. Put it behind HTTPS (reverse proxy) when public.
MC_BRIDGE_PORT=
MC_BRIDGE_HOST=0.0.0.0
